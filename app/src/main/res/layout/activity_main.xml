<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/brandBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/brand_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wordmark_first"
            android:textColor="@color/brand_ink"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wordmark_second"
            android:textColor="@color/brand_ink"
            android:textSize="23sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wordmark_dot"
            android:textColor="@color/brand_accent"
            android:textSize="23sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/toggleBarButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toggle_bar"
            android:src="@drawable/ic_chevron_up" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_line"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/feedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:minWidth="96dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/feed"
                android:textAllCaps="false"
                android:textColor="@color/chip_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/adminButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:minWidth="104dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/admin"
                android:textAllCaps="false"
                android:textColor="@color/chip_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/refreshButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:minWidth="112dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/refresh"
                android:textAllCaps="false"
                android:textColor="@color/chip_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/serverButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip"
                android:minWidth="96dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/server"
                android:textAllCaps="false"
                android:textColor="@color/chip_text"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/errorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/brand_soft"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:contentDescription="@string/cat_description"
                android:src="@drawable/waiting_cat" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/waiting_title"
                android:textColor="@color/brand_ink"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/errorBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/waiting_body"
                android:textColor="@color/brand_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_primary_button"
                android:minWidth="220dp"
                android:text="@string/retry"
                android:textAllCaps="false"
                android:textColor="@color/brand_on_accent"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="@string/waiting_hint"
                android:textColor="@color/brand_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
